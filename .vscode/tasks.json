{
    "version": "2.0.0",
    "tasks": [
        {"label": "Configure Debug", "type": "shell", "command": "cmake", "args": ["--preset", "debug"], "problemMatcher": "$gcc"},
        {
            "label": "Build Debug",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "--preset", "debug", "--parallel"],
            "dependsOn": "Configure Debug",
            "dependsOrder": "sequence",
            "group": {"kind": "build", "isDefault": true},
            "problemMatcher": "$gcc"
        },
        {"label": "Configure Debug Tests", "type": "shell", "command": "cmake", "args": ["--preset", "debug-tests"], "problemMatcher": "$gcc"},
        {
            "label": "Build Debug Tests",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "--preset", "debug-tests", "--parallel"],
            "dependsOn": "Configure Debug Tests",
            "dependsOrder": "sequence",
            "group": "build",
            "problemMatcher": "$gcc"
        },
        {
            "label": "Run Debug Unit Tests",
            "type": "shell",
            "command": "ctest",
            "args": ["--preset", "debug-tests"],
            "dependsOn": "Build Debug Tests",
            "dependsOrder": "sequence",
            "group": "test",
            "problemMatcher": "$gcc"
        },
        {"label": "Configure Release", "type": "shell", "command": "cmake", "args": ["--preset", "release"], "problemMatcher": "$gcc"},
        {
            "label": "Build Release",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "--preset", "release", "--parallel"],
            "dependsOn": "Configure Release",
            "dependsOrder": "sequence",
            "group": "build",
            "problemMatcher": "$gcc"
        },
        {"label": "Configure Release Tests", "type": "shell", "command": "cmake", "args": ["--preset", "release-tests"], "problemMatcher": "$gcc"},
        {
            "label": "Build Release Tests",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "--preset", "release-tests", "--parallel"],
            "dependsOn": "Configure Release Tests",
            "dependsOrder": "sequence",
            "group": "build",
            "problemMatcher": "$gcc"
        },
        {
            "label": "Run Release Unit Tests",
            "type": "shell",
            "command": "ctest",
            "args": ["--preset", "release-tests"],
            "dependsOn": "Build Release Tests",
            "dependsOrder": "sequence",
            "group": "test",
            "problemMatcher": "$gcc"
        },
        {
            "label": "Install Release",
            "type": "shell",
            "command": "cmake",
            "args": ["--install", "${workspaceFolder}/build/release"],
            "dependsOn": "Build Release",
            "dependsOrder": "sequence",
            "problemMatcher": "$gcc"
        },
        {
            "label": "Package Release",
            "type": "shell",
            "command": "cpack",
            "args": ["--preset", "release"],
            "dependsOn": "Build Release",
            "dependsOrder": "sequence",
            "problemMatcher": "$gcc"
        },
        {"label": "Configure Static Analysis", "type": "shell", "command": "cmake", "args": ["--preset", "debug-analysis"], "problemMatcher": "$gcc"},
        {
            "label": "Run Static Analysis",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "--preset", "debug-static-analysis", "--parallel"],
            "dependsOn": "Configure Static Analysis",
            "dependsOrder": "sequence",
            "group": "test",
            "problemMatcher": "$gcc"
        }
    ]
}
